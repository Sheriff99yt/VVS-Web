{
  "id": "javascript.base",
  "version": "1",
  "family": "javascript",
  "layout": {
    "indentUnit": "    ",
    "blockPlaceholder": "// empty",
    "commentPrefix": "// ",
    "instanceReceiver": "this",
    "statementSuffix": ";",
    "bodyIndent": "        ",
    "handlerBodyIndent": "        ",
    "memberChainIndent": "    ",
    "varDeclIndent": "    ",
    "emptyHandlerBody": "        // empty",
    "emptyFunctionBody": "        // empty",
    "importTemplate": {
      "quasi": "import * as {mod} from './{mod}';"
    }
  },
  "templates": {
    "Print": {
      "quasi": "console.log({value});"
    },
    "AssignInstance": {
      "quasi": "this.{target} = {value};"
    },
    "AssignLocal": {
      "quasi": "{target} = {value};"
    },
    "CallFunction": {
      "quasi": "{callee}({args});"
    },
    "CallInstance": {
      "quasi": "this.{callee}({args});"
    },
    "CallCrossClass": {
      "quasi": "{receiver}.{callee}({args});"
    },
    "CallCrossClassStatic": {
      "quasi": "{class}.{callee}({args});"
    },
    "DispatchEvent": {
      "quasi": "this.on_{handler}({args});"
    },
    "BindEvent": {
      "quasi": "{target}.on({event}, {handler});"
    },
    "DispatchEventCrossClass": {
      "quasi": "{receiver}.on_{handler}({args});"
    },
    "IfBranchHeader": {
      "quasi": "if ({cond}) {"
    },
    "IfBranchElse": {
      "quasi": "} else {"
    },
    "IfBranchClose": {
      "quasi": "};"
    },
    "ForLoopHeader": {
      "quasi": "for (let {index} = {first}; {index} <= {last}; {index}++) {"
    },
    "ForLoopClose": {
      "quasi": "};"
    },
    "WhileLoopHeader": {
      "quasi": "while ({cond}) {"
    },
    "WhileLoopClose": {
      "quasi": "};"
    },
    "SequenceHeader": {
      "quasi": "{"
    },
    "SequenceComment": {
      "quasi": "  // sequence"
    },
    "SequenceClose": {
      "quasi": "};"
    },
    "ModuleImport": {
      "quasi": "import * as {mod} from './{mod}';"
    },
    "ImportClass": {
      "quasi": "import { {class} } from './{mod}.js';"
    },
    "ImportClassAlias": {
      "quasi": "import { {class} as {alias} } from './{mod}.js';"
    },
    "AwaitWaitAsync": {
      "quasi": "await new Promise((resolve) => setTimeout(resolve, {duration} * 1000));"
    },
    "AwaitWaitSync": {
      "quasi": "for (let _until = Date.now() + ({duration}) * 1000; Date.now() < _until; ) {}"
    },
    "CallNative": {
      "quasi": "{call};"
    },
    "ConvertToString": {
      "quasi": "String({value})"
    },
    "ConvertToNumber": {
      "quasi": "parseFloat({value})"
    },
    "ConvertToNumberStrict": {
      "quasi": "Number({value})"
    },
    "InstanceRef": {
      "quasi": "this.{name}"
    },
    "NullLiteral": {
      "quasi": "null"
    },
    "BoolLiteralTrue": {
      "quasi": "true"
    },
    "VarDefine": {
      "quasi": "{staticKw}{visibility}{name} = {default};"
    },
    "DeclareLocal": {
      "quasi": "let {name};"
    },
    "DeclareLocalInitialized": {
      "quasi": "{keyword} {name} = {value};"
    },
    "ClassModuleOpen": {
      "quasi": "{prefix}class {name}{extendsSuffix} {"
    },
    "ClassModuleClose": {
      "quasi": "}"
    },
    "EventHandlerOpen": {
      "quasi": "{linePrefix}    {asyncKw}on_{handler}({paramList}) {"
    },
    "EventHandlerClose": {
      "quasi": "    }"
    },
    "ModuleFunctionDefOpen": {
      "quasi": "{exportKw}{asyncKw}function {name}({paramList}) {"
    },
    "ModuleFunctionDefClose": {
      "quasi": "}"
    },
    "FunctionDefOpen": {
      "quasi": "    {staticKw}{asyncKw}{name}({paramList}) {"
    },
    "FunctionTabClose": {
      "quasi": "    }"
    },
    "BoolLiteralFalse": {
      "quasi": "false"
    },
    "ConstructorOpen": {
      "quasi": "{linePrefix}constructor({paramList}) {"
    },
    "EnumMemberAccess": {
      "quasi": "{enum}.{member}"
    },
    "ModuleImportFrom": {
      "quasi": "import { {names} } from \"{mod}\""
    },
    "ModuleImportIncludeSystem": {
      "quasi": "import \"{mod}\""
    },
    "ReturnVal": {
      "quasi": "return {value};"
    },
    "ReturnVoid": {
      "quasi": "return;"
    },
    "Break": {
      "quasi": "break;"
    },
    "Continue": {
      "quasi": "continue;"
    },
    "CallSuper": {
      "quasi": "super.{callee}({args});"
    },
    "DispatchEventSuper": {
      "quasi": "super.on_{handler}({args});"
    },
    "Lambda": {
      "quasi": "({params}) => {body}"
    },
    "TryHeader": {
      "quasi": "try {"
    },
    "TryCatchHeader": {
      "quasi": "{catchClause}"
    },
    "TryFinallyHeader": {
      "quasi": "} finally {"
    },
    "TryClose": {
      "quasi": "}"
    },
    "Comparison": {
      "quasi": "({left} {operator} {right})"
    },
    "AssignCompound": {
      "quasi": "{target} {operator} {value};"
    },
    "UpdatePostfix": {
      "quasi": "{target}{operator};"
    },
    "UpdatePrefix": {
      "quasi": "{operator}{target};"
    },
    "ForStructuredHeader": {
      "quasi": "for ({initializer}; {condition}; {update}) {"
    },
    "LanguageDirective": {
      "quasi": "{value};"
    },
    "CallSuperConstructor": {
      "quasi": "super({args});"
    },
    "NativeScalar": {
      "quasi": "{value}"
    },
    "NativeBinary": {
      "quasi": "({left} {operator} {right})"
    },
    "NativeIndex": {
      "quasi": "{receiver}[{index}]"
    },
    "NativeMember": {
      "quasi": "({receiver}).{name}"
    },
    "NativeArray": {
      "quasi": "[{items}]"
    },
    "NativeObject": {
      "lego": [
        {
          "kind": "static",
          "name": "{"
        },
        {
          "kind": "slot",
          "name": "items"
        },
        {
          "kind": "static",
          "name": "}"
        }
      ]
    },
    "NativeTuple": {
      "quasi": "({items})"
    },
    "NativeEntry": {
      "quasi": "{key}: {value}"
    },
    "NativeComputedEntry": {
      "quasi": "[{key}]: {value}"
    },
    "NativeSpread": {
      "quasi": "...{value}"
    },
    "NativeDictSpread": {
      "quasi": "**{value}"
    },
    "NativeUnary": {
      "quasi": "({operator}({value}))"
    },
    "NativeOperatorBinary": {
      "quasi": "(({left}) {operator} ({right}))"
    }
  }
}
