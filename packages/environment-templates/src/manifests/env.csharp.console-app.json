{
  "id": "env.csharp.console-app",
  "version": "1.0.0",
  "displayName": "C# Console App",
  "description": "SDK-style .NET console app with Console.WriteLine / ReadLine natives and Program.cs entry.",
  "category": "console",
  "defaultTarget": "csharp",
  "supportedTargets": [
    "csharp",
    "python"
  ],
  "module": {
    "defaultName": "App",
    "extends": {
      "id": "object"
    }
  },
  "apiSurface": {
    "types": [
      {
        "id": "object",
        "displayName": "Object",
        "targets": {
          "csharp": {
            "extendsName": "object"
          },
          "python": {
            "extendsName": "object"
          }
        }
      }
    ],
    "methods": [
      {
        "id": "native.print",
        "name": "print",
        "parameters": [
          {
            "id": "msg",
            "label": "Message",
            "type": "data_string"
          }
        ],
        "role": "native",
        "targets": {
          "csharp": {
            "callExpr": "Console.WriteLine({msg})"
          },
          "python": {
            "callExpr": "print({msg})"
          }
        }
      },
      {
        "id": "native.read_line",
        "name": "read_line",
        "parameters": [],
        "role": "native",
        "targets": {
          "csharp": {
            "callExpr": "Console.ReadLine()"
          },
          "python": {
            "callExpr": "input()"
          }
        }
      },
      {
        "id": "lifecycle.run",
        "name": "run",
        "parameters": [],
        "role": "overrideable",
        "targets": {
          "csharp": {
            "callExpr": "base.Run()",
            "defHeader": "public virtual void Run() {"
          },
          "python": {
            "callExpr": "super().run()",
            "defHeader": "def run(self):"
          }
        }
      }
    ],
    "events": [
      {
        "id": "event.on_ready",
        "name": "on_ready",
        "parameters": []
      }
    ]
  },
  "hostFiles": [
    {
      "path": "Program.cs",
      "role": "entry",
      "template": "using System;\n\ninternal static class Program\n{\n    private static void Main()\n    {\n        var app = new {moduleName}();\n        app.on_start();\n    }\n}\n"
    },
    {
      "path": "App.csproj",
      "role": "config",
      "template": "<Project Sdk=\"Microsoft.NET.Sdk\">\n  <PropertyGroup>\n    <OutputType>Exe</OutputType>\n    <TargetFramework>net8.0</TargetFramework>\n    <ImplicitUsings>enable</ImplicitUsings>\n    <Nullable>enable</Nullable>\n  </PropertyGroup>\n</Project>\n"
    }
  ]
}
