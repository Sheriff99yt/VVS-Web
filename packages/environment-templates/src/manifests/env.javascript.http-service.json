{
  "id": "env.javascript.http-service",
  "version": "1.0.0",
  "displayName": "Node HTTP Service",
  "description": "Node http.createServer skeleton with a /health route and JSON response native — no extra framework.",
  "category": "api",
  "defaultTarget": "javascript",
  "supportedTargets": [
    "javascript",
    "python"
  ],
  "module": {
    "defaultName": "ApiService",
    "extends": {
      "id": "object"
    }
  },
  "apiSurface": {
    "types": [
      {
        "id": "object",
        "displayName": "Object",
        "targets": {
          "javascript": {
            "extendsName": "Object"
          },
          "python": {
            "extendsName": "object"
          }
        }
      }
    ],
    "methods": [
      {
        "id": "native.log",
        "name": "log",
        "parameters": [
          {
            "id": "msg",
            "label": "Message",
            "type": "data_string"
          }
        ],
        "role": "native",
        "targets": {
          "javascript": {
            "callExpr": "console.log({msg})"
          },
          "python": {
            "callExpr": "print({msg})"
          }
        }
      },
      {
        "id": "native.json_response",
        "name": "json_response",
        "parameters": [
          {
            "id": "body",
            "label": "Body",
            "type": "data_string"
          }
        ],
        "role": "native",
        "targets": {
          "javascript": {
            "callExpr": "JSON.stringify({body})"
          },
          "python": {
            "callExpr": "json.dumps({body})"
          }
        }
      },
      {
        "id": "lifecycle.run",
        "name": "run",
        "parameters": [],
        "role": "overrideable",
        "targets": {
          "javascript": {
            "callExpr": "super.run()",
            "defHeader": "run() {"
          },
          "python": {
            "callExpr": "super().run()",
            "defHeader": "def run(self):"
          }
        }
      },
      {
        "id": "handler.health",
        "name": "health",
        "parameters": [],
        "role": "overrideable",
        "targets": {
          "javascript": {
            "callExpr": "return { status: 'ok' }",
            "defHeader": "health() {"
          },
          "python": {
            "callExpr": "return {'status': 'ok'}",
            "defHeader": "def health(self):"
          }
        }
      }
    ],
    "events": [
      {
        "id": "event.on_ready",
        "name": "on_ready",
        "parameters": []
      },
      {
        "id": "event.on_request",
        "name": "on_request",
        "parameters": [
          {
            "id": "method",
            "label": "Method",
            "type": "data_string"
          },
          {
            "id": "path",
            "label": "Path",
            "type": "data_string"
          }
        ]
      }
    ]
  },
  "hostFiles": [
    {
      "path": "main.js",
      "role": "entry",
      "template": "import http from 'node:http';\nimport { {moduleName} } from './{moduleName}.js';\n\nconst app = new {moduleName}();\napp.on_start();\n\nconst server = http.createServer((req, res) => {\n  if (req.url === '/health') {\n    res.writeHead(200, { 'Content-Type': 'application/json' });\n    res.end(JSON.stringify({ status: 'ok' }));\n    return;\n  }\n  res.writeHead(404);\n  res.end();\n});\nserver.listen(3000);\n"
    },
    {
      "path": "package.json",
      "role": "config",
      "template": "{\n  \"name\": \"{moduleName}\",\n  \"type\": \"module\",\n  \"main\": \"main.js\"\n}\n"
    },
    {
      "path": "routes.json",
      "role": "config",
      "template": "{\n  \"routes\": [\n    { \"method\": \"GET\", \"path\": \"/health\", \"handler\": \"health\" }\n  ]\n}\n"
    }
  ]
}
