{
  "id": "env.javascript.data-script",
  "version": "1.0.0",
  "displayName": "Node Data Script",
  "description": "File-driven Node pipeline with fs.readFileSync and an on_row hook — CSV/JSON friendly.",
  "category": "data",
  "defaultTarget": "javascript",
  "supportedTargets": [
    "javascript",
    "python"
  ],
  "module": {
    "defaultName": "DataPipeline",
    "extends": {
      "id": "object"
    }
  },
  "apiSurface": {
    "types": [
      {
        "id": "object",
        "displayName": "Object",
        "targets": {
          "javascript": {
            "extendsName": "Object"
          },
          "python": {
            "extendsName": "object"
          }
        }
      }
    ],
    "methods": [
      {
        "id": "native.log",
        "name": "log",
        "parameters": [
          {
            "id": "msg",
            "label": "Message",
            "type": "data_string"
          }
        ],
        "role": "native",
        "targets": {
          "javascript": {
            "callExpr": "console.log({msg})"
          },
          "python": {
            "callExpr": "print({msg})"
          }
        }
      },
      {
        "id": "native.read_file",
        "name": "read_file",
        "parameters": [
          {
            "id": "path",
            "label": "Path",
            "type": "data_string"
          }
        ],
        "role": "native",
        "targets": {
          "javascript": {
            "callExpr": "fs.readFileSync({path}, 'utf8')"
          },
          "python": {
            "callExpr": "open({path}, encoding='utf-8').read()"
          }
        }
      },
      {
        "id": "lifecycle.run",
        "name": "run",
        "parameters": [],
        "role": "overrideable",
        "targets": {
          "javascript": {
            "callExpr": "super.run()",
            "defHeader": "run() {"
          },
          "python": {
            "callExpr": "super().run()",
            "defHeader": "def run(self):"
          }
        }
      }
    ],
    "events": [
      {
        "id": "event.on_ready",
        "name": "on_ready",
        "parameters": []
      },
      {
        "id": "event.on_row",
        "name": "on_row",
        "parameters": [
          {
            "id": "row",
            "label": "Row",
            "type": "data_string"
          }
        ]
      }
    ]
  },
  "hostFiles": [
    {
      "path": "main.js",
      "role": "entry",
      "template": "import fs from 'node:fs';\nimport { {moduleName} } from './{moduleName}.js';\n\nconst pipeline = new {moduleName}();\npipeline.on_start();\n"
    },
    {
      "path": "package.json",
      "role": "config",
      "template": "{\n  \"name\": \"{moduleName}\",\n  \"type\": \"module\",\n  \"main\": \"main.js\"\n}\n"
    },
    {
      "path": "data/sample.csv",
      "role": "asset",
      "template": "id,name\n1,example\n"
    }
  ]
}
