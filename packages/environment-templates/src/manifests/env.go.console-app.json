{
  "id": "env.go.console-app",
  "version": "1.0.0",
  "displayName": "Go Console App",
  "description": "Native Go binary with fmt.Println / bufio stdin I/O natives, main.go entry, and go.mod.",
  "category": "console",
  "defaultTarget": "go",
  "supportedTargets": [
    "go",
    "python"
  ],
  "module": {
    "defaultName": "App",
    "extends": {
      "id": "object"
    }
  },
  "apiSurface": {
    "types": [
      {
        "id": "object",
        "displayName": "Object",
        "targets": {
          "go": {},
          "python": {
            "extendsName": "object"
          }
        }
      }
    ],
    "methods": [
      {
        "id": "native.print",
        "name": "print",
        "parameters": [
          {
            "id": "msg",
            "label": "Message",
            "type": "data_string"
          }
        ],
        "role": "native",
        "targets": {
          "go": {
            "callExpr": "fmt.Println({msg})"
          },
          "python": {
            "callExpr": "print({msg})"
          }
        }
      },
      {
        "id": "native.read_line",
        "name": "read_line",
        "parameters": [],
        "role": "native",
        "targets": {
          "go": {
            "callExpr": "func() string { scanner := bufio.NewScanner(os.Stdin); scanner.Scan(); return scanner.Text() }()"
          },
          "python": {
            "callExpr": "input()"
          }
        }
      },
      {
        "id": "lifecycle.run",
        "name": "run",
        "parameters": [],
        "role": "overrideable",
        "targets": {
          "go": {
            "callExpr": "self.run()",
            "defHeader": "func (self *App) run() {"
          },
          "python": {
            "callExpr": "super().run()",
            "defHeader": "def run(self):"
          }
        }
      }
    ],
    "events": [
      {
        "id": "event.on_ready",
        "name": "on_ready",
        "parameters": []
      }
    ]
  },
  "hostFiles": [
    {
      "path": "main.go",
      "role": "entry",
      "template": "package main\n\nfunc main() {\n\tapp := &{moduleName}{}\n\tapp.on_start()\n}\n"
    },
    {
      "path": "go.mod",
      "role": "config",
      "template": "module app\n\ngo 1.22\n"
    }
  ]
}
