{
  "id": "env.rust.console-app",
  "version": "1.0.0",
  "displayName": "Rust Console App",
  "description": "Native Rust binary with println! / stdin I/O natives, src/main.rs entry, and Cargo.toml.",
  "category": "console",
  "defaultTarget": "rust",
  "supportedTargets": [
    "rust",
    "python"
  ],
  "module": {
    "defaultName": "App",
    "extends": {
      "id": "object"
    }
  },
  "apiSurface": {
    "types": [
      {
        "id": "object",
        "displayName": "Object",
        "targets": {
          "rust": {
            "extendsName": "Default"
          },
          "python": {
            "extendsName": "object"
          }
        }
      }
    ],
    "methods": [
      {
        "id": "native.print",
        "name": "print",
        "parameters": [
          {
            "id": "msg",
            "label": "Message",
            "type": "data_string"
          }
        ],
        "role": "native",
        "targets": {
          "rust": {
            "callExpr": "println!(\"{}\", {msg})"
          },
          "python": {
            "callExpr": "print({msg})"
          }
        }
      },
      {
        "id": "native.read_line",
        "name": "read_line",
        "parameters": [],
        "role": "native",
        "targets": {
          "rust": {
            "callExpr": "{ let mut line = String::new(); let _ = std::io::stdin().read_line(&mut line); line }"
          },
          "python": {
            "callExpr": "input()"
          }
        }
      },
      {
        "id": "lifecycle.run",
        "name": "run",
        "parameters": [],
        "role": "overrideable",
        "targets": {
          "rust": {
            "callExpr": "Self::run(self)",
            "defHeader": "fn run(&self) {"
          },
          "python": {
            "callExpr": "super().run()",
            "defHeader": "def run(self):"
          }
        }
      }
    ],
    "events": [
      {
        "id": "event.on_ready",
        "name": "on_ready",
        "parameters": []
      }
    ]
  },
  "hostFiles": [
    {
      "path": "src/main.rs",
      "role": "entry",
      "template": "fn main() {\n    let app = {moduleName}::default();\n    app.on_start();\n}\n"
    },
    {
      "path": "Cargo.toml",
      "role": "config",
      "template": "[package]\nname = \"app\"\nversion = \"0.1.0\"\nedition = \"2021\"\n\n[[bin]]\nname = \"app\"\npath = \"src/main.rs\"\n"
    },
    {
      "path": ".devcontainer/devcontainer.json",
      "role": "config",
      "template": "{\n  \"name\": \"Rust console\",\n  \"image\": \"mcr.microsoft.com/devcontainers/rust:1-1-bookworm\"\n}\n"
    }
  ],
  "devcontainer": {
    "path": ".devcontainer/devcontainer.json"
  }
}
