{
  "id": "env.go.http-service",
  "version": "1.0.0",
  "displayName": "Go HTTP Service",
  "description": "net/http ListenAndServe skeleton with a /health route ? standard library only.",
  "category": "api",
  "defaultTarget": "go",
  "supportedTargets": [
    "go",
    "python"
  ],
  "module": {
    "defaultName": "ApiService",
    "extends": {
      "id": "object"
    }
  },
  "apiSurface": {
    "types": [
      {
        "id": "object",
        "displayName": "Object",
        "targets": {
          "go": {},
          "python": {
            "extendsName": "object"
          }
        }
      }
    ],
    "methods": [
      {
        "id": "native.log",
        "name": "log",
        "parameters": [
          {
            "id": "msg",
            "label": "Message",
            "type": "data_string"
          }
        ],
        "role": "native",
        "targets": {
          "go": {
            "callExpr": "fmt.Println({msg})"
          },
          "python": {
            "callExpr": "print({msg})"
          }
        }
      },
      {
        "id": "lifecycle.run",
        "name": "run",
        "parameters": [],
        "role": "overrideable",
        "targets": {
          "go": {
            "callExpr": "self.run()",
            "defHeader": "func (self *ApiService) run() {"
          },
          "python": {
            "callExpr": "super().run()",
            "defHeader": "def run(self):"
          }
        }
      },
      {
        "id": "handler.health",
        "name": "health",
        "parameters": [],
        "role": "overrideable",
        "targets": {
          "go": {
            "callExpr": "return []byte(`{\"status\":\"ok\"}`)",
            "defHeader": "func (self *ApiService) health() []byte {"
          },
          "python": {
            "callExpr": "return {'status': 'ok'}",
            "defHeader": "def health(self):"
          }
        }
      }
    ],
    "events": [
      {
        "id": "event.on_ready",
        "name": "on_ready",
        "parameters": []
      },
      {
        "id": "event.on_request",
        "name": "on_request",
        "parameters": [
          {
            "id": "method",
            "label": "Method",
            "type": "data_string"
          },
          {
            "id": "path",
            "label": "Path",
            "type": "data_string"
          }
        ]
      }
    ]
  },
  "hostFiles": [
    {
      "path": "main.go",
      "role": "entry",
      "template": "package main\n\nimport (\n\t\"fmt\"\n\t\"net/http\"\n)\n\nfunc main() {\n\tapp := &{moduleName}{}\n\tapp.on_start()\n\thttp.HandleFunc(\"/health\", func(w http.ResponseWriter, r *http.Request) {\n\t\tw.Header().Set(\"Content-Type\", \"application/json\")\n\t\tfmt.Fprint(w, `{\"status\":\"ok\"}`)\n\t})\n\t_ = http.ListenAndServe(\":3000\", nil)\n}\n"
    },
    {
      "path": "go.mod",
      "role": "config",
      "template": "module app\n\ngo 1.22\n"
    }
  ]
}
