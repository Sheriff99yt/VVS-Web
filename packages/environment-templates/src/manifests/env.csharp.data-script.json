{
  "id": "env.csharp.data-script",
  "version": "1.0.0",
  "displayName": "C# Data Script",
  "description": "File-driven .NET console pipeline with File.ReadAllText and System.Text.Json ? no extra packages.",
  "category": "data",
  "defaultTarget": "csharp",
  "supportedTargets": [
    "csharp",
    "python"
  ],
  "module": {
    "defaultName": "DataPipeline",
    "extends": {
      "id": "object"
    }
  },
  "apiSurface": {
    "types": [
      {
        "id": "object",
        "displayName": "Object",
        "targets": {
          "csharp": {
            "extendsName": "object"
          },
          "python": {
            "extendsName": "object"
          }
        }
      }
    ],
    "methods": [
      {
        "id": "native.log",
        "name": "log",
        "parameters": [
          {
            "id": "msg",
            "label": "Message",
            "type": "data_string"
          }
        ],
        "role": "native",
        "targets": {
          "csharp": {
            "callExpr": "Console.WriteLine({msg})"
          },
          "python": {
            "callExpr": "print({msg})"
          }
        }
      },
      {
        "id": "native.read_file",
        "name": "read_file",
        "parameters": [
          {
            "id": "path",
            "label": "Path",
            "type": "data_string"
          }
        ],
        "role": "native",
        "targets": {
          "csharp": {
            "callExpr": "File.ReadAllText({path})"
          },
          "python": {
            "callExpr": "open({path}, encoding='utf-8').read()"
          }
        }
      },
      {
        "id": "native.parse_json",
        "name": "parse_json",
        "parameters": [
          {
            "id": "text",
            "label": "Text",
            "type": "data_string"
          }
        ],
        "role": "native",
        "targets": {
          "csharp": {
            "callExpr": "JsonSerializer.Deserialize<JsonElement>({text})"
          },
          "python": {
            "callExpr": "json.loads({text})"
          }
        }
      },
      {
        "id": "lifecycle.run",
        "name": "run",
        "parameters": [],
        "role": "overrideable",
        "targets": {
          "csharp": {
            "callExpr": "base.Run()",
            "defHeader": "public virtual void Run() {"
          },
          "python": {
            "callExpr": "super().run()",
            "defHeader": "def run(self):"
          }
        }
      }
    ],
    "events": [
      {
        "id": "event.on_ready",
        "name": "on_ready",
        "parameters": []
      },
      {
        "id": "event.on_row",
        "name": "on_row",
        "parameters": [
          {
            "id": "row",
            "label": "Row",
            "type": "data_string"
          }
        ]
      }
    ]
  },
  "hostFiles": [
    {
      "path": "Program.cs",
      "role": "entry",
      "template": "using System;\nusing System.IO;\nusing System.Text.Json;\n\ninternal static class Program\n{\n    private static void Main()\n    {\n        var pipeline = new {moduleName}();\n        pipeline.on_start();\n    }\n}\n"
    },
    {
      "path": "App.csproj",
      "role": "config",
      "template": "<Project Sdk=\"Microsoft.NET.Sdk\">\n  <PropertyGroup>\n    <OutputType>Exe</OutputType>\n    <TargetFramework>net8.0</TargetFramework>\n    <ImplicitUsings>enable</ImplicitUsings>\n    <Nullable>enable</Nullable>\n  </PropertyGroup>\n</Project>\n"
    },
    {
      "path": "data/sample.csv",
      "role": "asset",
      "template": "id,name\n1,example\n"
    }
  ]
}
